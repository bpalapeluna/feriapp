      "html": "\n<style data-kid=\"0\">\n    @import url('https://fonts.googleapis.com/css2?family=Nunito+Sans:wght@400;600;700&family=Outfit:wght@400;600;700&display=swap');\n\n    :root {\n        --color-ghost-white: #F8F8FF;\n        --color-light-sea-green: #20B2AA;\n        --color-oxford-navy: #003262;\n    }\n\n    body {\n        background: radial-gradient(circle at top right, white, var(--color-ghost-white));\n        font-family: 'Nunito Sans', sans-serif;\n        color: var(--color-oxford-navy);\n        overflow-x: clip;\n    }\n\n    .font-outfit { font-family: 'Outfit', sans-serif; }\n\n    /* Custom Scrollbar for the horizontal scroll if needed */\n    ::-webkit-scrollbar {\n        width: 0px;\n        height: 0px;\n    }\n\n    .bento-card {\n        background: white;\n        border-radius: 2rem;\n        border: 1px solid rgba(32, 178, 170, 0.1);\n        box-shadow: 0 4px 24px -1px rgba(0, 50, 98, 0.03);\n        transition: transform 0.3s ease;\n    }\n\n    /* Removed .bento-card:hover transition to avoid GSAP conflicts */\n\n    /* For Motion.js compatibility - pathLength handles drawing */\n    .progress-ring-circle {\n        /* No stroke-dasharray/offset here - let motion.js calculate it */\n    }\n\n    .nav-item {\n        @apply flex flex-col items-center justify-center gap-1 text-slate-400 flex-1;\n    }\n\n    .nav-item.active {\n        @apply text-[var(--color-light-sea-green)];\n    }\n\n    .nav-item i {\n        @apply text-xl;\n    }\n</style>\n\n<div class=\"max-w-[375px] mx-auto min-h-screen relative pb-40\" data-kid=\"1\">\n    \n    <header class=\"px-6 pt-10 pb-6 flex justify-between items-center\" data-kid=\"2\">\n        <div class=\"reveal-up\" data-kid=\"3\">\n            <h1 class=\"text-2xl font-bold font-outfit text-[var(--color-oxford-navy)]\" data-kid=\"4\">Hola, Juan! 👋</h1>\n            <p class=\"text-sm text-slate-500\" data-kid=\"5\">Puesto #42, Feria Iquique</p>\n        </div>\n        <div class=\"w-12 h-12 rounded-2xl overflow-hidden border-2 border-white shadow-sm reveal-up\" data-kid=\"6\">\n            <img src=\"https://i.pravatar.cc/100?u=juan\" alt=\"Juan's Avatar\" class=\"w-full h-full object-cover\" decoding=\"async\" loading=\"lazy\" data-kid=\"7\">\n        </div>\n    </header>\n\n    \n    <main class=\"px-6 space-y-6\" data-kid=\"8\">\n        \n        \n        <div class=\"grid grid-cols-2 gap-4\" data-kid=\"9\">\n            \n            <div class=\"bento-card p-5 h-44 flex flex-col justify-between reveal-stagger\" style=\"--i:0\" data-kid=\"10\">\n                <div data-kid=\"11\">\n                    <span class=\"text-[10px] font-bold uppercase tracking-widest text-slate-400\" data-kid=\"12\">Mi Crédito</span>\n                    <h2 class=\"text-2xl font-bold font-outfit text-[var(--color-oxford-navy)] mt-1\" data-kid=\"13\">$<span id=\"credit-amount\" data-kid=\"14\">0</span></h2>\n                </div>\n                <div data-kid=\"15\">\n                    <p class=\"text-[11px] text-[var(--color-light-sea-green)] font-bold mb-3\" data-kid=\"16\">Disponible hoy</p>\n                    <button class=\"bg-[var(--color-light-sea-green)] text-white text-[11px] font-bold py-2 px-5 rounded-full w-fit shadow-sm shadow-teal-200/50 hover:scale-105 active:scale-95 transition-all\" data-kid=\"17\">\n                        Solicitar\n                    </button>\n                </div>\n            </div>\n\n            \n            <div class=\"bg-[var(--color-light-sea-green)] rounded-[2rem] p-5 h-44 flex flex-col justify-between text-white shadow-lg shadow-teal-500/10 reveal-stagger\" style=\"--i:1\" data-kid=\"18\">\n                <div class=\"flex justify-between items-start\" data-kid=\"19\">\n                    <div class=\"w-10 h-10 rounded-xl bg-white/20 flex items-center justify-center\" data-kid=\"20\">\n                        <i class=\"ti ti-credit-card text-xl\" data-kid=\"21\"></i>\n                    </div>\n                    <div class=\"flex items-center gap-1.5 bg-white/20 px-2 py-1 rounded-full\" data-kid=\"22\">\n                        <div class=\"w-1.5 h-1.5 rounded-full bg-green-300 animate-pulse\" data-kid=\"23\"></div>\n                        <span class=\"text-[8px] font-bold tracking-tighter uppercase\" data-kid=\"24\">Live</span>\n                    </div>\n                </div>\n                <div data-kid=\"25\">\n                    <span class=\"text-[10px] opacity-80 font-semibold block\" data-kid=\"26\">Tarjeta FeriApp</span>\n                    <span class=\"text-lg font-bold font-outfit uppercase tracking-tight\" data-kid=\"27\">ACTIVA</span>\n                </div>\n            </div>\n        </div>\n\n        \n        <div class=\"bento-card p-6 reveal-stagger\" style=\"--i:2\" data-kid=\"28\">\n            <div class=\"flex justify-between items-center mb-6\" data-kid=\"29\">\n                <h3 class=\"text-sm font-bold font-outfit text-[var(--color-oxford-navy)]\" data-kid=\"30\">Pago de Deuda</h3>\n                <i class=\"ti ti-dots text-slate-300\" data-kid=\"31\"></i>\n            </div>\n            \n            <div class=\"relative w-44 h-44 mx-auto flex items-center justify-center\" data-kid=\"32\">\n                \n                <svg class=\"absolute inset-0 w-full h-full -rotate-90\" viewBox=\"0 0 200 200\" data-kid=\"33\">\n                    <circle cx=\"100\" cy=\"100\" r=\"80\" stroke=\"#F1F5F9\" stroke-width=\"14\" fill=\"none\" data-kid=\"34\"></circle>\n                </svg>\n                \n                <svg class=\"absolute inset-0 w-full h-full -rotate-90\" viewBox=\"0 0 200 200\" data-kid=\"35\">\n                    <circle id=\"debt-progress\" class=\"progress-ring-circle\" cx=\"100\" cy=\"100\" r=\"80\" stroke=\"var(--color-light-sea-green)\" stroke-width=\"14\" fill=\"none\" stroke-linecap=\"round\" data-kid=\"36\"></circle>\n                </svg>\n                <div class=\"text-center relative z-10\" data-kid=\"37\">\n                    <span class=\"text-5xl font-bold text-[var(--color-oxford-navy)] font-outfit block leading-none\" data-kid=\"38\"><span id=\"debt-percent\" data-kid=\"39\">0</span>%</span>\n                    <span class=\"text-[10px] text-slate-400 font-bold uppercase tracking-[0.15em] mt-1 block\" data-kid=\"40\">Pagado</span>\n                </div>\n            </div>\n\n            <div class=\"mt-8 flex items-center gap-4 bg-slate-50/50 p-4 rounded-2xl border border-slate-100\" data-kid=\"41\">\n                <div class=\"w-10 h-10 rounded-xl bg-white shadow-xs flex items-center justify-center text-[var(--color-oxford-navy)]\" data-kid=\"42\">\n                    <i class=\"ti ti-calendar-event text-lg\" data-kid=\"43\"></i>\n                </div>\n                <div class=\"flex-1\" data-kid=\"44\">\n                    <p class=\"text-[10px] text-slate-400 font-bold uppercase leading-none mb-1\" data-kid=\"45\">Próximo Vencimiento</p>\n                    <p class=\"text-sm font-bold text-[var(--color-oxford-navy)]\" data-kid=\"46\">15 de Octubre, 2024</p>\n                </div>\n                <button class=\"bg-[var(--color-oxford-navy)] text-white text-[11px] font-bold px-4 py-2.5 rounded-xl active:scale-95 transition-transform\" data-kid=\"47\">\n                    Pagar\n                </button>\n            </div>\n        </div>\n\n        \n        <div class=\"space-y-3 pb-6 reveal-stagger\" style=\"--i:3\" data-kid=\"48\">\n            <h3 class=\"text-[10px] font-bold text-slate-400 uppercase tracking-[0.2em] ml-2\" data-kid=\"49\">Gestión del Puesto</h3>\n            <div class=\"bg-white rounded-[2rem] border border-teal-100/30 shadow-xs overflow-hidden\" data-kid=\"50\">\n                \n                <button class=\"w-full flex items-center justify-between p-5 hover:bg-slate-50 transition-all group border-b border-slate-50\" data-kid=\"51\">\n                    <div class=\"flex items-center gap-4\" data-kid=\"52\">\n                        <div class=\"w-12 h-12 rounded-2xl bg-[var(--color-light-sea-green)]/10 flex items-center justify-center text-[var(--color-light-sea-green)] group-hover:scale-110 transition-transform shadow-xs\" data-kid=\"53\">\n                            <i class=\"ti ti-package-export text-xl\" data-kid=\"54\"></i>\n                        </div>\n                        <span class=\"font-bold text-[var(--color-oxford-navy)] text-base\" data-kid=\"55\">Editar Productos</span>\n                    </div>\n                    <i class=\"ti ti-chevron-right text-slate-300 group-hover:text-[var(--color-light-sea-green)] group-hover:translate-x-1 transition-all\" data-kid=\"56\"></i>\n                </button>\n                \n                \n                <button class=\"w-full flex items-center justify-between p-5 hover:bg-slate-50 transition-all group border-b border-slate-50\" data-kid=\"57\">\n                    <div class=\"flex items-center gap-4\" data-kid=\"58\">\n                        <div class=\"w-12 h-12 rounded-2xl bg-[var(--color-light-sea-green)]/10 flex items-center justify-center text-[var(--color-light-sea-green)] group-hover:scale-110 transition-transform shadow-xs\" data-kid=\"59\">\n                            <i class=\"ti ti-shopping-cart text-xl\" data-kid=\"60\"></i>\n                        </div>\n                        <span class=\"font-bold text-[var(--color-oxford-navy)] text-base\" data-kid=\"61\">Ver Pedidos</span>\n                    </div>\n                    <div class=\"flex items-center gap-2\" data-kid=\"62\">\n                        <span class=\"bg-red-500 text-white text-[10px] font-bold px-2.5 py-1 rounded-full shadow-sm shadow-red-200\" data-kid=\"63\">3</span>\n                        <i class=\"ti ti-chevron-right text-slate-300 group-hover:text-[var(--color-light-sea-green)] group-hover:translate-x-1 transition-all\" data-kid=\"64\"></i>\n                    </div>\n                </button>\n\n                \n                <button class=\"w-full flex items-center justify-between p-5 hover:bg-slate-50 transition-all group\" data-kid=\"65\">\n                    <div class=\"flex items-center gap-4\" data-kid=\"66\">\n                        <div class=\"w-12 h-12 rounded-2xl bg-[var(--color-light-sea-green)]/10 flex items-center justify-center text-[var(--color-light-sea-green)] group-hover:scale-110 transition-transform shadow-xs\" data-kid=\"67\">\n                            <i class=\"ti ti-report-analytics text-xl\" data-kid=\"68\"></i>\n                        </div>\n                        <span class=\"font-bold text-[var(--color-oxford-navy)] text-base\" data-kid=\"69\">Reporte de Ventas</span>\n                    </div>\n                    <i class=\"ti ti-chevron-right text-slate-300 group-hover:text-[var(--color-light-sea-green)] group-hover:translate-x-1 transition-all\" data-kid=\"70\"></i>\n                </button>\n            </div>\n        </div>\n    </main>\n\n    \n    <nav class=\"fixed bottom-0 left-0 right-0 bg-white/95 backdrop-blur-md border-t border-slate-100 px-4 pt-3 pb-6 flex justify-between items-end z-50 shadow-[0_-8px_30px_rgb(0,0,0,0.04)]\" data-kid=\"71\">\n        <div class=\"nav-item active\" data-kid=\"72\">\n            <i class=\"ti ti-smart-home\" data-kid=\"73\"></i>\n            <span class=\"text-[9px] font-bold uppercase tracking-tighter\" data-kid=\"74\">Inicio</span>\n        </div>\n        <div class=\"nav-item\" data-kid=\"75\">\n            <i class=\"ti ti-clipboard-list\" data-kid=\"76\"></i>\n            <span class=\"text-[9px] font-bold uppercase tracking-tighter\" data-kid=\"77\">Pedidos</span>\n        </div>\n        \n        \n        <div class=\"relative w-16 h-14 flex items-center justify-center\" data-kid=\"78\">\n            <button id=\"fab-button\" class=\"absolute -top-7 w-14 h-14 bg-[var(--color-oxford-navy)] rounded-full flex items-center justify-center text-white shadow-xl shadow-blue-900/30 active:scale-90 transition-transform group border-4 border-white\" data-kid=\"79\">\n                <i class=\"ti ti-building-store text-2xl group-hover:rotate-12 transition-transform\" data-kid=\"80\"></i>\n            </button>\n            <span class=\"absolute bottom-0 text-[9px] font-bold uppercase tracking-widest text-[var(--color-oxford-navy)]\" data-kid=\"81\">Tienda</span>\n        </div>\n\n        <div class=\"nav-item\" data-kid=\"82\">\n            <i class=\"ti ti-credit-card\" data-kid=\"83\"></i>\n            <span class=\"text-[9px] font-bold uppercase tracking-tighter\" data-kid=\"84\">Crédito</span>\n        </div>\n        <div class=\"nav-item\" data-kid=\"85\">\n            <i class=\"ti ti-user-circle\" data-kid=\"86\"></i>\n            <span class=\"text-[9px] font-bold uppercase tracking-tighter\" data-kid=\"87\">Perfil</span>\n        </div>\n    </nav>\n</div>\n\n\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js\" data-kid=\"88\"></script>\n<script type=\"module\" data-kid=\"89\">\n    import { animate, inView, scroll } from \"https://cdn.jsdelivr.net/npm/motion@12/+esm\"\n    import Lenis from \"https://esm.sh/lenis@1\"\n\n    // Initialize Smooth Scroll\n    const lenis = new Lenis()\n    function raf(time) {\n        lenis.raf(time)\n        requestAnimationFrame(raf)\n    }\n    requestAnimationFrame(raf)\n\n    // GSAP Entrance Animations\n    gsap.from(\".reveal-up\", {\n        y: 30,\n        opacity: 0,\n        duration: 1.2,\n        stagger: 0.2,\n        ease: \"power4.out\",\n        delay: 0.1\n    });\n\n    gsap.from(\".reveal-stagger\", {\n        y: 40,\n        opacity: 0,\n        duration: 1,\n        stagger: 0.15,\n        ease: \"power3.out\",\n        delay: 0.3\n    });\n\n    // Motion.js Count Up & Progress Ring\n    inView(\"main\", ({ target }) => {\n        // Reset and trigger animations\n        \n        // Credit Amount Count Up\n        animate(0, 120000, {\n            duration: 2.5,\n            ease: \"circOut\",\n            onUpdate: (latest) => {\n                const el = document.getElementById(\"credit-amount\");\n                if (el) el.textContent = Math.round(latest).toLocaleString('es-CL');\n            }\n        });\n\n        // Debt Percentage Count Up\n        animate(0, 65, {\n            duration: 2.5,\n            ease: \"circOut\",\n            onUpdate: (latest) => {\n                const el = document.getElementById(\"debt-percent\");\n                if (el) el.textContent = Math.round(latest);\n            }\n        });\n\n        // Progress Ring Drawing\n        animate(\"#debt-progress\", { pathLength: [0, 0.65] }, {\n            duration: 2.5,\n            ease: \"circOut\"\n        });\n\n        return () => {}; // Cleanup\n    }, { amount: 0.1 });\n\n    // Spring pop on FAB click\n    const fab = document.getElementById('fab-button');\n    if (fab) {\n        fab.addEventListener('click', () => {\n            animate(fab, { scale: [1, 1.2, 1] }, {\n                type: \"spring\",\n                visualDuration: 0.4,\n                bounce: 0.5\n            });\n        });\n    }\n</script>\n\n<link rel=\"stylesheet\" href=\"https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css\" data-kid=\"90\">\n<link rel=\"stylesheet\" href=\"https://unpkg.com/lenis@1/dist/lenis.css\" data-kid=\"91\">\n",
