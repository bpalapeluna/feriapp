      "html": "\n<section class=\"min-h-screen bg-[#F8F8FF] pt-12 pb-16 px-5 font-['Nunito_Sans'] flex flex-col items-center justify-start overflow-x-clip select-none\" data-kid=\"0\">\n    <style data-kid=\"1\">\n        @import url('https://fonts.googleapis.com/css2?family=Outfit:wght@400;600;700&family=Nunito+Sans:wght@400;600;700;800&display=swap');\n        \n        .font-outfit { font-family: 'Outfit', sans-serif; }\n        \n        ::-webkit-scrollbar {\n            width: 6px;\n        }\n        ::-webkit-scrollbar-track {\n            background: #F8F8FF;\n        }\n        ::-webkit-scrollbar-thumb {\n            background: #20B2AA40;\n            border-radius: 10px;\n        }\n        \n        .custom-shadow {\n            box-shadow: 0 24px 48px -12px rgba(0, 50, 98, 0.08);\n        }\n\n        .input-focus-effect:focus-within {\n            border-color: #20B2AA;\n            background-color: white;\n            box-shadow: 0 0 0 4px rgba(32, 178, 170, 0.1);\n        }\n\n        .soft-pill-shadow {\n            box-shadow: 0 8px 20px -4px rgba(32, 178, 170, 0.2);\n        }\n    </style>\n\n    \n    <div class=\"w-full max-w-[375px] mb-8 relative\" id=\"header-area\" data-kid=\"2\">\n        <div class=\"w-full h-40 rounded-[32px] overflow-hidden shadow-sm border border-[#003262]/5 relative group\" data-kid=\"3\">\n            <img src=\"https://images.unsplash.com/photo-1758184449358-ac6f5dcd8e04?auto=format&w=600&q=80&fit=crop\" alt=\"Street Market Vendor Scene\" class=\"w-full h-full object-cover grayscale-[10%] group-hover:grayscale-0 transition-all duration-700\" decoding=\"async\" loading=\"lazy\" data-kid=\"4\">\n            <div class=\"absolute inset-0 bg-gradient-to-t from-[#003262]/70 to-transparent\" data-kid=\"5\"></div>\n            <div class=\"absolute bottom-6 left-8\" data-kid=\"6\">\n                <h1 class=\"font-outfit text-3xl font-bold text-white tracking-tight\" data-kid=\"7\">FeriApp</h1>\n                <p class=\"text-white/80 font-semibold text-sm\" data-kid=\"8\">Tu mercado digital</p>\n            </div>\n            <div class=\"absolute top-6 right-8 w-12 h-12 bg-white/20 backdrop-blur-md rounded-full flex items-center justify-center border border-white/30\" data-kid=\"9\">\n                <i class=\"ti ti-building-store text-2xl text-white\" data-kid=\"10\"></i>\n            </div>\n        </div>\n    </div>\n\n    \n    <main class=\"w-full max-w-[375px] bg-white rounded-[40px] custom-shadow border border-[#003262]/5 overflow-hidden\" id=\"auth-card\" data-kid=\"11\">\n        \n        \n        <div class=\"p-6 pb-2\" data-kid=\"12\">\n            <div class=\"flex p-1.5 bg-[#F8F8FF] rounded-2xl border border-[#003262]/5\" id=\"tabs\" data-kid=\"13\">\n                <button onclick=\"switchTab('login')\" id=\"tab-login\" class=\"flex-1 py-3.5 text-sm font-extrabold rounded-xl transition-all duration-300 bg-white text-[#20B2AA] shadow-sm\" data-kid=\"14\">\n                    Iniciar Sesión\n                </button>\n                <button onclick=\"switchTab('register')\" id=\"tab-register\" class=\"flex-1 py-3.5 text-sm font-extrabold rounded-xl transition-all duration-300 text-[#003262]/60 hover:text-[#003262]\" data-kid=\"15\">\n                    Registrarme\n                </button>\n            </div>\n        </div>\n\n        <div class=\"p-8 pt-4\" data-kid=\"16\">\n            \n            <form id=\"login-form\" class=\"space-y-6\" data-kid=\"17\">\n                <div class=\"space-y-2\" data-kid=\"18\">\n                    <label class=\"block text-sm font-extrabold text-[#003262] ml-1\" data-kid=\"19\">Email o RUT</label>\n                    <div class=\"relative input-focus-effect bg-[#F8F8FF] rounded-2xl border-2 border-transparent transition-all overflow-hidden group\" data-kid=\"20\">\n                        <div class=\"absolute inset-y-0 left-4 flex items-center pointer-events-none transition-colors group-focus-within:text-[#20B2AA]\" data-kid=\"21\">\n                            <i class=\"ti ti-user-circle text-[#003262]/60 text-xl\" data-kid=\"22\"></i>\n                        </div>\n                        <input type=\"text\" placeholder=\"Ej: 12.345.678-9\" class=\"w-full pl-12 pr-5 py-4 bg-transparent outline-hidden text-[#003262] font-semibold placeholder:text-[#003262]/60\" data-kid=\"23\">\n                    </div>\n                </div>\n\n                <div class=\"space-y-2\" data-kid=\"24\">\n                    <label class=\"block text-sm font-extrabold text-[#003262] ml-1\" data-kid=\"25\">Contraseña</label>\n                    <div class=\"relative input-focus-effect bg-[#F8F8FF] rounded-2xl border-2 border-transparent transition-all overflow-hidden group\" data-kid=\"26\">\n                        <div class=\"absolute inset-y-0 left-4 flex items-center pointer-events-none transition-colors group-focus-within:text-[#20B2AA]\" data-kid=\"27\">\n                            <i class=\"ti ti-lock-square text-[#003262]/60 text-xl\" data-kid=\"28\"></i>\n                        </div>\n                        <input type=\"password\" placeholder=\"Tu contraseña\" class=\"w-full pl-12 pr-5 py-4 bg-transparent outline-hidden text-[#003262] font-semibold placeholder:text-[#003262]/60\" data-kid=\"29\">\n                    </div>\n                </div>\n\n                <div class=\"flex items-center justify-between px-1\" data-kid=\"30\">\n                    <label class=\"flex items-center space-x-2 cursor-pointer group\" data-kid=\"31\">\n                        <input type=\"checkbox\" class=\"w-5 h-5 rounded-md border-2 border-[#20B2AA]/30 text-[#20B2AA] focus:ring-0\" data-kid=\"32\">\n                        <span class=\"text-xs font-bold text-[#003262]/70 group-hover:text-[#003262] transition-colors\" data-kid=\"33\">Recordarme</span>\n                    </label>\n                    <a href=\"#\" class=\"text-xs font-bold text-[#20B2AA] hover:underline\" data-kid=\"34\">¿Olvidaste la clave?</a>\n                </div>\n\n                <button type=\"submit\" class=\"w-full py-4.5 bg-[#20B2AA] text-white font-extrabold rounded-full soft-pill-shadow hover:bg-[#1CA098] hover:-translate-y-0.5 active:translate-y-0 active:scale-95 transition-all duration-300\" data-kid=\"35\">\n                    Iniciar Sesión\n                </button>\n            </form>\n\n            \n            <form id=\"register-form\" class=\"hidden space-y-5\" data-kid=\"36\">\n                <div class=\"space-y-2\" data-kid=\"37\">\n                    <label class=\"block text-sm font-extrabold text-[#003262] ml-1\" data-kid=\"38\">Nombre Completo</label>\n                    <div class=\"relative input-focus-effect bg-[#F8F8FF] rounded-2xl border-2 border-transparent transition-all overflow-hidden group\" data-kid=\"39\">\n                        <div class=\"absolute inset-y-0 left-4 flex items-center pointer-events-none transition-all duration-300 group-focus-within:text-[#20B2AA] group-focus-within:scale-110\" data-kid=\"40\">\n                            <i class=\"ti ti-user text-[#003262]/60 text-xl\" data-kid=\"41\"></i>\n                        </div>\n                        <input type=\"text\" placeholder=\"Ej: Juan Pérez\" class=\"w-full pl-12 pr-5 py-4 bg-transparent outline-hidden text-[#003262] font-semibold placeholder:text-[#003262]/60\" data-kid=\"42\">\n                    </div>\n                </div>\n\n                <div class=\"grid grid-cols-2 gap-4\" data-kid=\"43\">\n                    <div class=\"space-y-2\" data-kid=\"44\">\n                        <label class=\"block text-sm font-extrabold text-[#003262] ml-1\" data-kid=\"45\">RUT</label>\n                        <input type=\"text\" placeholder=\"12.345.678-9\" class=\"w-full px-5 py-4 bg-[#F8F8FF] rounded-2xl border-2 border-transparent focus:border-[#20B2AA] focus:bg-white outline-hidden text-[#003262] font-semibold placeholder:text-[#003262]/60 transition-all\" data-kid=\"46\">\n                    </div>\n                    <div class=\"space-y-2\" data-kid=\"47\">\n                        <label class=\"block text-sm font-extrabold text-[#003262] ml-1\" data-kid=\"48\">Patente Municipal</label>\n                        <input type=\"text\" placeholder=\"Nº 9876\" class=\"w-full px-5 py-4 bg-[#F8F8FF] rounded-2xl border-2 border-transparent focus:border-[#20B2AA] focus:bg-white outline-hidden text-[#003262] font-semibold placeholder:text-[#003262]/60 transition-all\" data-kid=\"49\">\n                    </div>\n                </div>\n\n                <div class=\"space-y-2\" data-kid=\"50\">\n                    <label class=\"block text-sm font-extrabold text-[#003262] ml-1\" data-kid=\"51\">Correo Electrónico</label>\n                    <div class=\"relative input-focus-effect bg-[#F8F8FF] rounded-2xl border-2 border-transparent transition-all overflow-hidden group\" data-kid=\"52\">\n                        <div class=\"absolute inset-y-0 left-4 flex items-center pointer-events-none transition-all duration-300 group-focus-within:text-[#20B2AA] group-focus-within:scale-110\" data-kid=\"53\">\n                            <i class=\"ti ti-mail text-[#003262]/60 text-xl\" data-kid=\"54\"></i>\n                        </div>\n                        <input type=\"email\" placeholder=\"email@ejemplo.com\" class=\"w-full pl-12 pr-5 py-4 bg-transparent outline-hidden text-[#003262] font-semibold placeholder:text-[#003262]/60\" data-kid=\"55\">\n                    </div>\n                </div>\n\n                <div class=\"space-y-2\" data-kid=\"56\">\n                    <label class=\"block text-sm font-extrabold text-[#003262] ml-1\" data-kid=\"57\">Crear Contraseña</label>\n                    <div class=\"relative input-focus-effect bg-[#F8F8FF] rounded-2xl border-2 border-transparent transition-all overflow-hidden group\" data-kid=\"58\">\n                        <div class=\"absolute inset-y-0 left-4 flex items-center pointer-events-none transition-all duration-300 group-focus-within:text-[#20B2AA] group-focus-within:scale-110\" data-kid=\"59\">\n                            <i class=\"ti ti-lock text-[#003262]/60 text-xl\" data-kid=\"60\"></i>\n                        </div>\n                        <input type=\"password\" placeholder=\"Mínimo 8 caracteres\" class=\"w-full pl-12 pr-5 py-4 bg-transparent outline-hidden text-[#003262] font-semibold placeholder:text-[#003262]/60\" data-kid=\"61\">\n                    </div>\n                </div>\n\n                <button type=\"submit\" class=\"w-full py-4.5 bg-[#20B2AA] text-white font-extrabold rounded-full soft-pill-shadow hover:bg-[#1CA098] hover:-translate-y-0.5 active:translate-y-0 active:scale-95 transition-all duration-300 mt-2\" data-kid=\"62\">\n                    Comenzar Registro\n                </button>\n            </form>\n        </div>\n        \n        \n        <div class=\"bg-[#F8F8FF] p-6 text-center border-t border-[#003262]/5\" data-kid=\"63\">\n            <p class=\"text-xs text-[#003262]/60 font-bold uppercase tracking-widest mb-4\" data-kid=\"64\">¿Necesitas ayuda?</p>\n            <div class=\"flex justify-center space-x-8\" data-kid=\"65\">\n                <a href=\"#\" class=\"flex flex-col items-center group\" data-kid=\"66\">\n                    <div class=\"w-11 h-11 rounded-full bg-white flex items-center justify-center text-[#20B2AA] shadow-sm group-hover:bg-[#20B2AA] group-hover:text-white transition-all duration-300\" data-kid=\"67\">\n                        <i class=\"ti ti-brand-whatsapp text-2xl\" data-kid=\"68\"></i>\n                    </div>\n                    <span class=\"text-xs font-extrabold text-[#003262]/70 mt-2\" data-kid=\"69\">Soporte</span>\n                </a>\n                <a href=\"#\" class=\"flex flex-col items-center group\" data-kid=\"70\">\n                    <div class=\"w-11 h-11 rounded-full bg-white flex items-center justify-center text-[#20B2AA] shadow-sm group-hover:bg-[#20B2AA] group-hover:text-white transition-all duration-300\" data-kid=\"71\">\n                        <i class=\"ti ti-help text-2xl\" data-kid=\"72\"></i>\n                    </div>\n                    <span class=\"text-xs font-extrabold text-[#003262]/70 mt-2\" data-kid=\"73\">Guía</span>\n                </a>\n            </div>\n        </div>\n    </main>\n\n    \n    <div class=\"mt-12 opacity-30 pointer-events-none flex justify-center space-x-8\" id=\"footer-decor\" data-kid=\"74\">\n        <i class=\"ti ti-leaf text-4xl text-[#20B2AA]\" data-kid=\"75\"></i>\n        <i class=\"ti ti-basket text-4xl text-[#20B2AA]\" data-kid=\"76\"></i>\n        <i class=\"ti ti-carrot text-4xl text-[#20B2AA]\" data-kid=\"77\"></i>\n    </div>\n\n    <link rel=\"stylesheet\" href=\"https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css\" data-kid=\"78\">\n    \n    <script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js\" data-kid=\"79\"></script>\n    <script type=\"module\" data-kid=\"80\">\n        import { animate, spring } from \"https://cdn.jsdelivr.net/npm/motion@12/+esm\"\n\n        // Animation on Load\n        window.addEventListener('DOMContentLoaded', () => {\n            gsap.from(\"#header-area\", {\n                y: -30,\n                opacity: 0,\n                duration: 1,\n                ease: \"power3.out\"\n            });\n            \n            gsap.from(\"#auth-card\", {\n                y: 50,\n                opacity: 0,\n                duration: 1.2,\n                delay: 0.2,\n                ease: \"power4.out\"\n            });\n\n            gsap.from(\"#footer-decor i\", {\n                y: 20,\n                opacity: 0,\n                stagger: 0.1,\n                duration: 1,\n                delay: 0.8,\n                ease: \"back.out(1.7)\"\n            });\n        });\n\n        // Tab Switching Logic\n        window.switchTab = (type) => {\n            const loginForm = document.getElementById('login-form');\n            const registerForm = document.getElementById('register-form');\n            const tabLogin = document.getElementById('tab-login');\n            const tabRegister = document.getElementById('tab-register');\n\n            if (type === 'login') {\n                if (!registerForm.classList.contains('hidden')) {\n                    tabLogin.classList.add('bg-white', 'text-[#20B2AA]', 'shadow-sm');\n                    tabLogin.classList.remove('text-[#003262]/60');\n                    tabRegister.classList.remove('bg-white', 'text-[#20B2AA]', 'shadow-sm');\n                    tabRegister.classList.add('text-[#003262]/60');\n\n                    animate(registerForm, { opacity: 0, x: 20 }, { duration: 0.25, ease: \"easeIn\" }).finished.then(() => {\n                        registerForm.classList.add('hidden');\n                        loginForm.classList.remove('hidden');\n                        animate(loginForm, { opacity: [0, 1], x: [-20, 0] }, { duration: 0.4, ease: \"easeOut\" });\n                    });\n                }\n            } else {\n                if (!loginForm.classList.contains('hidden')) {\n                    tabRegister.classList.add('bg-white', 'text-[#20B2AA]', 'shadow-sm');\n                    tabRegister.classList.remove('text-[#003262]/60');\n                    tabLogin.classList.remove('bg-white', 'text-[#20B2AA]', 'shadow-sm');\n                    tabLogin.classList.add('text-[#003262]/60');\n\n                    animate(loginForm, { opacity: 0, x: -20 }, { duration: 0.25, ease: \"easeIn\" }).finished.then(() => {\n                        loginForm.classList.add('hidden');\n                        registerForm.classList.remove('hidden');\n                        animate(registerForm, { opacity: [0, 1], x: [20, 0] }, { duration: 0.4, ease: \"easeOut\" });\n                    });\n                }\n            }\n        };\n    </script>\n</section>\n",
