      "html": "\n<style data-kid=\"0\">\n  @import url('https://fonts.googleapis.com/css2?family=Outfit:wght@400;600;700&family=Nunito+Sans:wght@300;400;600;700&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n  @import url('https://unpkg.com/lenis@1/dist/lenis.css');\n\n  :root {\n    --ghost-white: #F8F8FF;\n    --light-sea-green: #20B2AA;\n    --oxford-navy: #003262;\n    --hairline-border: #d0d0cc;\n  }\n\n  body {\n    margin: 0;\n    padding: 0;\n    font-family: 'Nunito Sans', sans-serif;\n    background-color: var(--ghost-white);\n    color: var(--oxford-navy);\n  }\n\n  .font-outfit { font-family: 'Outfit', sans-serif; }\n  .font-nunito { font-family: 'Nunito Sans', sans-serif; }\n\n  /* Custom styling for horizontal scroll category reel */\n  .no-scrollbar::-webkit-scrollbar { display: none; }\n  .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }\n\n  /* Locomotive Reveal Stagger */\n  [data-scroll].is-inview {\n    opacity: 1;\n    transform: translateY(0);\n    transition: opacity 0.6s cubic-bezier(0.23, 1, 0.32, 1), transform 0.6s cubic-bezier(0.23, 1, 0.32, 1);\n    transition-delay: calc(var(--i) * 100ms);\n  }\n\n  .reveal-init {\n    opacity: 0;\n    transform: translateY(20px);\n  }\n\n  /* Glassmorphism for Navbar */\n  .glass-navbar {\n    background: rgba(255, 255, 255, 0.2);\n    backdrop-filter: blur(12px);\n    -webkit-backdrop-filter: blur(12px);\n    border-bottom: 1px solid rgba(255, 255, 255, 0.3);\n  }\n</style>\n\n\n<nav class=\"fixed top-0 left-0 w-full z-50 px-6 py-4 flex items-center justify-between bg-[#F8F8FF]/80 backdrop-blur-md border-b border-[#20B2AA]/10\" data-kid=\"1\">\n  <div class=\"flex items-center gap-2\" data-kid=\"2\">\n    <div class=\"w-10 h-10 rounded-xl bg-[#20B2AA] flex items-center justify-center shadow-sm\" data-kid=\"3\">\n      <i class=\"ti ti-shopping-bag text-white text-xl\" data-kid=\"4\"></i>\n    </div>\n    <span class=\"font-outfit font-bold text-[#003262] text-2xl tracking-tight\" data-kid=\"5\">FeriApp</span>\n  </div>\n  <div class=\"flex items-center gap-4\" data-kid=\"6\">\n    <div class=\"relative w-10 h-10 rounded-full bg-white flex items-center justify-center shadow-xs text-[#003262]\" data-kid=\"7\">\n      <i class=\"ti ti-bell text-xl\" data-kid=\"8\"></i>\n      <span class=\"absolute top-2 right-2 w-2 h-2 bg-red-500 rounded-full border border-white\" data-kid=\"9\"></span>\n    </div>\n    <div class=\"w-10 h-10 rounded-full border-2 border-[#20B2AA]/20 overflow-hidden shadow-xs\" data-kid=\"10\">\n      <img src=\"https://i.pravatar.cc/100?u=vendor\" alt=\"User Profile\" class=\"w-full h-full object-cover\" data-kid=\"11\">\n    </div>\n  </div>\n</nav>\n\n\n<nav class=\"fixed bottom-0 left-0 w-full h-20 bg-white border-t border-[#d0d0cc]/30 px-6 flex items-center justify-between z-50 rounded-t-[32px] shadow-[0_-8px_32px_rgba(0,0,0,0.04)]\" data-kid=\"12\">\n  <button class=\"flex flex-col items-center gap-1 text-[#20B2AA] group cursor-pointer w-14\" data-kid=\"13\">\n    <div class=\"relative\" data-kid=\"14\">\n      <i class=\"ti ti-smart-home text-2xl transition-transform group-active:scale-90\" data-kid=\"15\"></i>\n      <span class=\"absolute -bottom-1 left-1/2 -translate-x-1/2 w-1 h-1 bg-[#20B2AA] rounded-full\" data-kid=\"16\"></span>\n    </div>\n    <span class=\"text-[9px] font-outfit font-bold uppercase tracking-widest\" data-kid=\"17\">Inicio</span>\n  </button>\n  <button class=\"flex flex-col items-center gap-1 text-[#003262]/30 group cursor-pointer w-14\" data-kid=\"18\">\n    <i class=\"ti ti-shopping-cart text-2xl transition-transform group-active:scale-90\" data-kid=\"19\"></i>\n    <span class=\"text-[9px] font-nunito font-bold uppercase tracking-widest\" data-kid=\"20\">Pedidos</span>\n  </button>\n  \n  \n  <div class=\"w-16\" data-kid=\"21\"></div>\n\n  <button class=\"flex flex-col items-center gap-1 text-[#003262]/30 group cursor-pointer w-14\" data-kid=\"22\">\n    <i class=\"ti ti-ticket text-2xl transition-transform group-active:scale-90\" data-kid=\"23\"></i>\n    <span class=\"text-[9px] font-nunito font-bold uppercase tracking-widest\" data-kid=\"24\">Cupones</span>\n  </button>\n  <button class=\"flex flex-col items-center gap-1 text-[#003262]/30 group cursor-pointer w-14\" data-kid=\"25\">\n    <i class=\"ti ti-user-circle text-2xl transition-transform group-active:scale-90\" data-kid=\"26\"></i>\n    <span class=\"text-[9px] font-nunito font-bold uppercase tracking-widest\" data-kid=\"27\">Perfil</span>\n  </button>\n\n  \n  <div class=\"absolute -top-10 left-1/2 -translate-x-1/2 flex flex-col items-center\" data-kid=\"28\">\n    <div id=\"fab-main\" class=\"w-16 h-16 rounded-3xl bg-[#20B2AA] shadow-[0_12px_28px_rgba(32,178,170,0.3)] flex items-center justify-center text-white cursor-pointer hover:shadow-[0_16px_32px_rgba(32,178,170,0.5)] transition-all border-4 border-white\" data-kid=\"29\">\n      <i class=\"ti ti-building-store text-3xl\" data-kid=\"30\"></i>\n    </div>\n    <span class=\"mt-1.5 text-[9px] font-outfit font-bold text-[#003262] uppercase tracking-widest text-center\" data-kid=\"31\">Mi Puesto</span>\n  </div>\n</nav>\n\n<div class=\"relative min-h-screen flex flex-col pt-20\" data-scroll-container data-kid=\"32\">\n  \n  \n  <header class=\"relative w-full py-12 px-6 overflow-hidden bg-white\" data-kid=\"33\">\n    <div class=\"absolute inset-0 bg-radial-gradient from-[#20B2AA]/5 to-transparent opacity-60\" data-kid=\"34\"></div>\n    <div class=\"relative z-10 flex flex-col items-center max-w-md mx-auto\" data-kid=\"35\">\n      <h1 class=\"font-outfit font-bold text-[#003262] text-3xl text-center mb-8 tracking-tight\" data-scroll data-kid=\"36\">\n        ¡Hola! Busquemos lo mejor de la feria\n      </h1>\n      \n      \n      <div class=\"w-full relative group\" data-scroll data-kid=\"37\">\n        <div class=\"relative\" data-kid=\"38\">\n          <input type=\"text\" placeholder=\"Busca frutas, verduras o locales...\" class=\"w-full h-14 pl-12 pr-6 bg-[#F8F8FF] rounded-2xl shadow-sm border border-[#20B2AA]/10 text-[#003262] font-nunito text-base focus:ring-4 focus:ring-[#20B2AA]/10 transition-all outline-hidden\" data-kid=\"39\">\n          <i class=\"ti ti-search absolute left-4 top-1/2 -translate-y-1/2 text-xl text-[#20B2AA]\" data-kid=\"40\"></i>\n          <button class=\"absolute right-2 top-1/2 -translate-y-1/2 w-10 h-10 rounded-xl bg-white flex items-center justify-center text-[#20B2AA] shadow-xs cursor-pointer\" data-kid=\"41\">\n            <i class=\"ti ti-adjustments-horizontal text-lg\" data-kid=\"42\"></i>\n          </button>\n        </div>\n      </div>\n    </div>\n  </header>\n\n  \n  <section class=\"w-full py-6 bg-white relative z-10\" data-kid=\"43\">\n    <div class=\"flex overflow-x-auto gap-8 px-6 no-scrollbar\" data-kid=\"44\">\n      \n      <div class=\"flex flex-col items-center gap-3 shrink-0 group cursor-pointer\" data-kid=\"45\">\n        <div class=\"w-18 h-18 rounded-[28px] border-2 border-[#20B2AA] p-1.5 bg-white shadow-sm transition-transform group-active:scale-95 flex items-center justify-center\" data-kid=\"46\">\n          <div class=\"w-full h-full rounded-[22px] bg-[#20B2AA]/10 flex items-center justify-center text-[#20B2AA]\" data-kid=\"47\">\n            <i class=\"ti ti-apple text-4xl\" data-kid=\"48\"></i>\n          </div>\n        </div>\n        <span class=\"text-[12px] font-outfit font-bold text-[#003262]\" data-kid=\"49\">Frutas</span>\n      </div>\n      \n      <div class=\"flex flex-col items-center gap-3 shrink-0 group cursor-pointer\" data-kid=\"50\">\n        <div class=\"w-18 h-18 rounded-3xl border-2 border-transparent p-1.5 bg-[#F8F8FF] transition-transform group-active:scale-95 flex items-center justify-center\" data-kid=\"51\">\n          <div class=\"w-full h-full rounded-2xl bg-white flex items-center justify-center text-[#003262]/40\" data-kid=\"52\">\n            <i class=\"ti ti-carrot text-3xl\" data-kid=\"53\"></i>\n          </div>\n        </div>\n        <span class=\"text-[11px] font-nunito font-semibold text-[#003262]/40\" data-kid=\"54\">Verduras</span>\n      </div>\n      \n      <div class=\"flex flex-col items-center gap-3 shrink-0 group cursor-pointer\" data-kid=\"55\">\n        <div class=\"w-18 h-18 rounded-3xl border-2 border-transparent p-1.5 bg-[#F8F8FF] transition-transform group-active:scale-95 flex items-center justify-center\" data-kid=\"56\">\n          <div class=\"w-full h-full rounded-2xl bg-white flex items-center justify-center text-[#003262]/40\" data-kid=\"57\">\n            <i class=\"ti ti-bread text-3xl\" data-kid=\"58\"></i>\n          </div>\n        </div>\n        <span class=\"text-[11px] font-nunito font-semibold text-[#003262]/40\" data-kid=\"59\">Panadería</span>\n      </div>\n      \n      <div class=\"flex flex-col items-center gap-3 shrink-0 group cursor-pointer\" data-kid=\"60\">\n        <div class=\"w-18 h-18 rounded-3xl border-2 border-transparent p-1.5 bg-[#F8F8FF] transition-transform group-active:scale-95 flex items-center justify-center\" data-kid=\"61\">\n          <div class=\"w-full h-full rounded-2xl bg-white flex items-center justify-center text-[#003262]/40\" data-kid=\"62\">\n            <i class=\"ti ti-bottle text-3xl\" data-kid=\"63\"></i>\n          </div>\n        </div>\n        <span class=\"text-[11px] font-nunito font-semibold text-[#003262]/40\" data-kid=\"64\">Lácteos</span>\n      </div>\n      \n      <div class=\"flex flex-col items-center gap-3 shrink-0 group cursor-pointer\" data-kid=\"65\">\n        <div class=\"w-18 h-18 rounded-3xl border-2 border-transparent p-1.5 bg-[#F8F8FF] transition-transform group-active:scale-95 flex items-center justify-center\" data-kid=\"66\">\n          <div class=\"w-full h-full rounded-2xl bg-white flex items-center justify-center text-[#003262]/40\" data-kid=\"67\">\n            <i class=\"ti ti-meat text-3xl\" data-kid=\"68\"></i>\n          </div>\n        </div>\n        <span class=\"text-[11px] font-nunito font-semibold text-[#003262]/40\" data-kid=\"69\">Carnes</span>\n      </div>\n    </div>\n  </section>\n\n  \n  <main class=\"w-full px-4 pt-4\" data-kid=\"70\">\n    <div class=\"flex items-center justify-between mb-6 px-2\" data-kid=\"71\">\n      <h2 class=\"font-outfit font-bold text-2xl text-[#003262]\" data-kid=\"72\">Destacados de hoy</h2>\n      <a href=\"#\" class=\"text-[#20B2AA] font-bold text-sm\" data-kid=\"73\">Ver todo</a>\n    </div>\n\n    <div class=\"flex flex-col gap-0 bg-white rounded-3xl overflow-hidden shadow-sm border border-[#d0d0cc]/40\" data-kid=\"74\">\n      \n      \n      <article class=\"flex items-center gap-5 bg-white p-5 border-b border-[#d0d0cc]/20 reveal-init\" data-scroll style=\"--i: 0\" data-kid=\"75\">\n        <div class=\"w-20 h-20 shrink-0 rounded-xl overflow-hidden bg-gray-50 border border-gray-100\" data-kid=\"76\">\n          <img src=\"https://images.unsplash.com/photo-1760705186373-f0fccf98b88c?auto=format&w=200&q=80&fit=crop\" alt=\"Vibrant assortment of fruits at a market stall\" decoding=\"async\" loading=\"lazy\" class=\"w-full h-full object-cover\" data-kid=\"77\">\n        </div>\n        <div class=\"flex-1 min-w-0\" data-kid=\"78\">\n          <h3 class=\"font-outfit font-bold text-[#003262] text-base leading-tight mb-0.5 truncate\" data-kid=\"79\">Pack Mix Frutal Premium</h3>\n          <p class=\"font-nunito text-[#20B2AA] font-extrabold text-lg leading-none mb-1\" data-kid=\"80\">$4.500 <span class=\"text-[10px] text-[#003262]/40 font-normal\" data-kid=\"81\">/ unid.</span></p>\n          <div class=\"flex items-center gap-2\" data-kid=\"82\">\n            <span class=\"px-1.5 py-0.5 bg-emerald-50 text-emerald-600 text-[9px] font-bold rounded uppercase\" data-kid=\"83\">Orgánico</span>\n            <div class=\"flex items-center gap-0.5\" data-kid=\"84\">\n              <i class=\"ti ti-star-filled text-yellow-400 text-[10px]\" data-kid=\"85\"></i>\n              <span class=\"text-[10px] font-bold text-[#003262]/60\" data-kid=\"86\">4.9</span>\n            </div>\n          </div>\n        </div>\n        <button class=\"shrink-0 w-11 h-11 rounded-2xl bg-[#20B2AA] text-white flex items-center justify-center shadow-md active:scale-90 transition-transform cursor-pointer\" data-kid=\"87\">\n          <i class=\"ti ti-plus text-2xl\" data-kid=\"88\"></i>\n        </button>\n      </article>\n\n      \n      <article class=\"flex items-center gap-5 bg-white p-5 border-b border-[#d0d0cc]/20 reveal-init\" data-scroll style=\"--i: 1\" data-kid=\"89\">\n        <div class=\"w-20 h-20 shrink-0 rounded-xl overflow-hidden bg-gray-50 border border-gray-100\" data-kid=\"90\">\n          <img src=\"https://images.unsplash.com/photo-1762474453560-5cf30f20bc8e?auto=format&w=200&q=80&fit=crop\" alt=\"Fresh fruit stall\" decoding=\"async\" loading=\"lazy\" class=\"w-full h-full object-cover\" data-kid=\"91\">\n        </div>\n        <div class=\"flex-1 min-w-0\" data-kid=\"92\">\n          <h3 class=\"font-outfit font-bold text-[#003262] text-base leading-tight mb-0.5 truncate\" data-kid=\"93\">Naranjas de Temporada</h3>\n          <p class=\"font-nunito text-[#20B2AA] font-extrabold text-lg leading-none mb-1\" data-kid=\"94\">$1.200 <span class=\"text-[10px] text-[#003262]/40 font-normal\" data-kid=\"95\">/ kg</span></p>\n          <div class=\"flex items-center gap-2\" data-kid=\"96\">\n            <span class=\"px-1.5 py-0.5 bg-orange-50 text-orange-600 text-[9px] font-bold rounded uppercase\" data-kid=\"97\">Local</span>\n            <div class=\"flex items-center gap-0.5\" data-kid=\"98\">\n              <i class=\"ti ti-star-filled text-yellow-400 text-[10px]\" data-kid=\"99\"></i>\n              <span class=\"text-[10px] font-bold text-[#003262]/60\" data-kid=\"100\">4.7</span>\n            </div>\n          </div>\n        </div>\n        <button class=\"shrink-0 w-10 h-10 rounded-full bg-[#20B2AA] text-white flex items-center justify-center shadow-md active:scale-90 transition-transform cursor-pointer\" data-kid=\"101\">\n          <i class=\"ti ti-plus text-xl\" data-kid=\"102\"></i>\n        </button>\n      </article>\n\n      \n      <article class=\"flex items-center gap-4 bg-white p-4 border-b border-[#d0d0cc]/20 reveal-init\" data-scroll style=\"--i: 2\" data-kid=\"103\">\n        <div class=\"w-20 h-20 shrink-0 rounded-xl overflow-hidden bg-gray-50 border border-gray-100\" data-kid=\"104\">\n          <img src=\"https://images.unsplash.com/photo-1763054760673-bd6866c35d48?auto=format&w=200&q=80&fit=crop\" alt=\"Vibrant fruit\" decoding=\"async\" loading=\"lazy\" class=\"w-full h-full object-cover\" data-kid=\"105\">\n        </div>\n        <div class=\"flex-1 min-w-0\" data-kid=\"106\">\n          <h3 class=\"font-outfit font-bold text-[#003262] text-base leading-tight mb-0.5 truncate\" data-kid=\"107\">Papas Amarillas XL</h3>\n          <p class=\"font-nunito text-[#20B2AA] font-extrabold text-lg leading-none mb-1\" data-kid=\"108\">$950 <span class=\"text-[10px] text-[#003262]/40 font-normal\" data-kid=\"109\">/ kg</span></p>\n          <div class=\"flex items-center gap-2\" data-kid=\"110\">\n            <span class=\"px-1.5 py-0.5 bg-gray-50 text-gray-600 text-[9px] font-bold rounded uppercase\" data-kid=\"111\">Fresco</span>\n            <div class=\"flex items-center gap-0.5\" data-kid=\"112\">\n              <i class=\"ti ti-star-filled text-yellow-400 text-[10px]\" data-kid=\"113\"></i>\n              <span class=\"text-[10px] font-bold text-[#003262]/60\" data-kid=\"114\">4.5</span>\n            </div>\n          </div>\n        </div>\n        <button class=\"shrink-0 w-10 h-10 rounded-full bg-[#20B2AA] text-white flex items-center justify-center shadow-md active:scale-90 transition-transform cursor-pointer\" data-kid=\"115\">\n          <i class=\"ti ti-plus text-xl\" data-kid=\"116\"></i>\n        </button>\n      </article>\n\n      \n      <article class=\"flex items-center gap-4 bg-white p-4 reveal-init\" data-scroll style=\"--i: 3\" data-kid=\"117\">\n        <div class=\"w-20 h-20 shrink-0 rounded-xl overflow-hidden bg-gray-50 border border-gray-100\" data-kid=\"118\">\n          <img src=\"https://images.unsplash.com/photo-1771574207594-bd699319b900?auto=format&w=200&q=80&fit=crop\" alt=\"Vibrant display\" decoding=\"async\" loading=\"lazy\" class=\"w-full h-full object-cover\" data-kid=\"119\">\n        </div>\n        <div class=\"flex-1 min-w-0\" data-kid=\"120\">\n          <h3 class=\"font-outfit font-bold text-[#003262] text-base leading-tight mb-0.5 truncate\" data-kid=\"121\">Palta Hass Selección</h3>\n          <p class=\"font-nunito text-[#20B2AA] font-extrabold text-lg leading-none mb-1\" data-kid=\"122\">$5.900 <span class=\"text-[10px] text-[#003262]/40 font-normal\" data-kid=\"123\">/ kg</span></p>\n          <div class=\"flex items-center gap-2\" data-kid=\"124\">\n            <span class=\"px-1.5 py-0.5 bg-emerald-50 text-emerald-600 text-[9px] font-bold rounded uppercase\" data-kid=\"125\">Orgánico</span>\n            <div class=\"flex items-center gap-0.5\" data-kid=\"126\">\n              <i class=\"ti ti-star-filled text-yellow-400 text-[10px]\" data-kid=\"127\"></i>\n              <span class=\"text-[10px] font-bold text-[#003262]/60\" data-kid=\"128\">5.0</span>\n            </div>\n          </div>\n        </div>\n        <button class=\"shrink-0 w-10 h-10 rounded-full bg-[#20B2AA] text-white flex items-center justify-center shadow-md active:scale-90 transition-transform cursor-pointer\" data-kid=\"129\">\n          <i class=\"ti ti-plus text-xl\" data-kid=\"130\"></i>\n        </button>\n      </article>\n\n    </div>\n  </main>\n\n  \n  <div class=\"h-32\" data-kid=\"131\"></div>\n\n</div>\n\n\n<script src=\"https://cdn.jsdelivr.net/npm/locomotive-scroll@5/bundled/locomotive-scroll.min.js\" data-kid=\"132\"></script>\n<link rel=\"stylesheet\" href=\"https://cdn.jsdelivr.net/npm/locomotive-scroll@5/bundled/locomotive-scroll.css\" data-kid=\"133\">\n<script type=\"module\" data-kid=\"134\">\n  import { animate, spring } from \"https://cdn.jsdelivr.net/npm/motion@12/+esm\"\n\n  // Initialize Locomotive Scroll\n  const locomotiveScroll = new LocomotiveScroll({\n    lenisOptions: {\n      lerp: 0.1,\n      duration: 1.2,\n      smoothWheel: true,\n    }\n  });\n\n  // FAB Spring Animation\n  const fab = document.getElementById('fab-main');\n  \n  fab.addEventListener('mouseenter', () => {\n    animate(fab, \n      { scale: 1.1, rotate: -5 }, \n      { type: \"spring\", stiffness: 300, damping: 10 }\n    );\n  });\n\n  fab.addEventListener('mouseleave', () => {\n    animate(fab, \n      { scale: 1, rotate: 0 }, \n      { type: \"spring\", stiffness: 300, damping: 10 }\n    );\n  });\n\n  fab.addEventListener('mousedown', () => {\n    animate(fab, { scale: 0.9 }, { type: \"spring\", stiffness: 500, damping: 15 });\n  });\n\n  fab.addEventListener('mouseup', () => {\n    animate(fab, { scale: 1 }, { type: \"spring\", stiffness: 500, damping: 15 });\n  });\n\n  // Simple \"Buy\" buttons feedback\n  document.querySelectorAll('button').forEach(btn => {\n    btn.addEventListener('click', (e) => {\n      animate(e.currentTarget, { scale: [1, 0.9, 1] }, { duration: 0.2 });\n    });\n  });\n\n</script>\n",
